# This file is an example. Copy it to .env and fill in the values for local development.
# Do NOT commit the .env file to version control.

# --- CORS Configuration ---
# Comma-separated list of allowed origins for CORS
# Local: http://localhost:3000,http://localhost:5173,http://localhost:1420,tauri://localhost,http://tauri.localhost
# Test: https://clones-site-test.fly.dev,https://api-staging.clones-ai.com,tauri://localhost,http://tauri.localhost,http://localhost:3000
# Prod: https://clones-ai.com,https://api.clones-ai.com,tauri://localhost,http://tauri.localhost
# Note: Tauri origins (tauri://localhost,http://tauri.localhost) must be included in ALL environments 
#       to allow the desktop application to communicate with the API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:1420,tauri://localhost,http://tauri.localhost

# --- Base Blockchain ---
RPC_URL=https://sepolia.base.org

# --- API Keys ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Mongodb ----
DB_URI=mongodb://admin:admin@mongodb:27017/dev?authSource=admin

# --- Referral System ---
# Admin authentication token for referral system endpoints
ADMIN_TOKEN=
# Frontend URL for generating referral links
FRONTEND_URL=https://clones-ai.com

# --- THE GRAPH ---
GRAPH_ENDPOINT=
GRAPH_API_KEY=

# --- Blockchain Configuration ---
# Factory contract address for reward pools
REWARD_POOL_FACTORY_ADDRESS=
# ClaimRouter contract address for batch claims
CLAIM_ROUTER_ADDRESS=
# Publisher wallet address for claim authorization signatures
PUBLISHER_ADDRESS=
# Publisher private key for signing claim authorizations (EIP-712)
PUBLISHER_PRIVATE_KEY=
# Optional: Old publisher private key during rotation grace period
OLD_PUBLISHER_PRIVATE_KEY=

# Session security
SESSION_SECRET=
CSRF_DEBUG=

# --- Object Storage Configuration ---
# For local development with LocalStack
STORAGE_ACCESS_KEY=test
STORAGE_SECRET_KEY=test
STORAGE_ENDPOINT=http://localstack:4566
STORAGE_REGION=us-east-1
STORAGE_BUCKET=training-gym

# For test/production with Tigris:
# STORAGE_ACCESS_KEY=your_tigris_access_key
# STORAGE_SECRET_KEY=your_tigris_secret_key
# STORAGE_ENDPOINT=https://fly.storage.dev
# STORAGE_REGION=auto
# STORAGE_BUCKET=clones-backend-test (or clones-backend-prod)

# CQA Models
CQA_MODEL=gpt-4o-mini
CQA_EVALUATION_MODEL=gpt-4o-mini

# --- Price USD API Configuration ---
# URL for the clones-supply-api service for fetching token prices
PRICE_USD_API_URL=http://host.docker.internal:8080
# API key for production access to the price USD API endpoints
PRICE_USD_API_KEY=

# --- Telegram Notifications (Optional) ---
# Bot token from @BotFather (leave empty to disable notifications)
TELEGRAM_BOT_TOKEN=
# Channel ID or chat ID where to send notifications (e.g., @channelname or -1001234567890)
TELEGRAM_CHANNEL_ID=
# Optional webhook secret for additional security
TELEGRAM_WEBHOOK_SECRET=
