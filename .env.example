# This file is an example. Copy it to .env and fill in the values for local development.
# Do NOT commit the .env file to version control.

# --- Base Blockchain ---
RPC_URL=https://sepolia.base.org

# --- API Keys ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Mongodb ----
DB_URI=mongodb://admin:admin@mongodb:27017/dev?authSource=admin

# --- Referral System ---
# Admin authentication token for referral system endpoints
ADMIN_TOKEN=
# Frontend URL for generating referral links
FRONTEND_URL=https://clones-ai.com

# --- THE GRAPH ---
GRAPH_ENDPOINT=
GRAPH_API_KEY=

# --- Blockchain Configuration ---
# Factory contract address for reward pools
REWARD_POOL_FACTORY_ADDRESS=
# ClaimRouter contract address for batch claims
CLAIM_ROUTER_ADDRESS=
# Publisher wallet address for claim authorization signatures
PUBLISHER_ADDRESS=
# Publisher private key for signing claim authorizations (EIP-712)
PUBLISHER_PRIVATE_KEY=
# Optional: Old publisher private key during rotation grace period
OLD_PUBLISHER_PRIVATE_KEY=

# Session security
SESSION_SECRET=
CSRF_DEBUG=

# --- Object Storage Configuration ---
# For local development with LocalStack
STORAGE_ACCESS_KEY=test
STORAGE_SECRET_KEY=test
STORAGE_ENDPOINT=http://localstack:4566
STORAGE_REGION=us-east-1
STORAGE_BUCKET=training-gym

# For test/production with Tigris:
# STORAGE_ACCESS_KEY=your_tigris_access_key
# STORAGE_SECRET_KEY=your_tigris_secret_key
# STORAGE_ENDPOINT=https://fly.storage.dev
# STORAGE_REGION=auto
# STORAGE_BUCKET=clones-backend-test (or clones-backend-prod)