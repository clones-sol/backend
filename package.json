{
  "name": "clones-backend",
  "version": "1.2.0",
  "description": "",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "build": "node esbuild.js",
    "start": "node build/server.js",
    "tsc": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:json": "vitest run --reporter json",
    "typecheck": "tsc --noEmit",
    "typecov": "type-coverage --detail --ignoreCatch",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "lint:unsafe-fix": "biome check --write --unsafe src/",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "quality": "npm run typecheck && npm run lint && npm run test",
    "quality:fix": "npm run typecheck && npm run lint:fix",
    "prepare": "husky install"
  },
  "lint-staged": {
    "src/**/*.{js,ts,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
